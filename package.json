{
  "name": "clan-quests-bot",
  "version": "2.5.46",
  "private": true,
  "description": "Arabic clan automatic daily quests, bank and activity leaderboards",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "diagnose": "node --env-file-if-exists=.env scripts/diagnose-auth.js",
    "test": "node --test test/*.test.js",
    "test:db": "node --env-file-if-exists=.env --test test/database.integration.js test/auction.database.integration.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "discord.js": "14.27.0",
    "discord.js-selfbot-v13": "3.7.1",
    "mongodb": "6.21.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.2.0"
  }
}
